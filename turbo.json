{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!.turbo/**"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "build:desktop-agent": {
      "dependsOn": [
        "@nibi/shared-types#build",
        "@nibi/contracts#build",
        "@nibi/dynamic-workflow#build",
        "@nibi/core#build",
        "@nibi/adapters#build",
        "@nibi/bootstrap#build",
        "@nibi/i18n#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/zcode-cli/package.json",
        "$TURBO_ROOT$/apps/zcode-cli/.env",
        "$TURBO_ROOT$/packages/shared/package.json",
        "$TURBO_ROOT$/packages/shared/src/**",
        "!dist/**",
        "!.turbo/**",
        "$TURBO_ROOT$/config/provider/nibi-builtin.json",
        "$TURBO_ROOT$/config/provider/nibi-builtin.test.json",
        "$TURBO_ROOT$/scripts/builtin-provider-config.mjs",
        "$TURBO_ROOT$/packages/provider/src/**",
        "$TURBO_ROOT$/packages/provider-node/src/nibi-builtin-release.ts",
        "$TURBO_ROOT$/packages/model-option-map/src/**",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/.env.production",
        "$TURBO_ROOT$/.env.development",
        "$TURBO_ROOT$/.env.development.local",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ],
      "outputs": ["dist/**"],
      "cache": true,
      "env": ["NIBI_ENV", "NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["**"],
      "env": ["NIBI_CUA_REPO", "VITEST_MAX_WORKERS"],
      "outputs": []
    },
    "coverage": {
      "dependsOn": ["build"],
      "inputs": ["**"],
      "outputs": ["coverage/**"]
    },
    "lint": {},
    "lint:fix": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "@nibi/cli#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!.turbo/**",
        "$TURBO_ROOT$/config/provider/nibi-builtin.json",
        "$TURBO_ROOT$/config/provider/nibi-builtin.test.json",
        "$TURBO_ROOT$/scripts/builtin-provider-config.mjs",
        "$TURBO_ROOT$/packages/provider/src/**",
        "$TURBO_ROOT$/packages/provider-node/src/nibi-builtin-release.ts",
        "$TURBO_ROOT$/packages/model-option-map/src/**",
        "$TURBO_ROOT$/packages/shared/src/**",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/.env.production",
        "$TURBO_ROOT$/.env.development",
        "$TURBO_ROOT$/.env.development.local",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ],
      "outputs": ["dist/**"],
      "cache": true,
      "env": ["NIBI_ENV", "NODE_ENV"]
    }
  }
}
