{
  "name": "nibi",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "concurrently -k -n server,web -c blue,green \"pnpm --filter @nibi/server dev\" \"pnpm --filter @nibi/web dev\"",
    "dev:docs": "pnpm --filter @nibi/dev-docs dev",
    "dev:desktop": "pnpm run dev:desktop:prod",
    "dev:desktop:test": "node scripts/dev-desktop-env.mjs test",
    "dev:desktop:prod": "node scripts/dev-desktop-env.mjs production",
    "dev:desktop:bytecode": "node scripts/dev-desktop-env.mjs production --agent-bytecode",
    "dev:e2e-report": "pnpm --filter @nibi/e2e-report dev",
    "dev:desktop:remote-prod": "node scripts/dev-desktop-remote-prod.mjs",
    "dev:web-remote-control": "node scripts/build-desktop-agent-cli.mjs && concurrently -k -n web,desktop -c green,magenta \"pnpm --filter @nibi/web exec vite dev --strictPort\" \"node scripts/dev-web-remote-control-desktop.mjs\"",
    "dev:web-share:test": "node scripts/dev-web-share-env.mjs test",
    "dev:web-share:mock": "node scripts/dev-web-share-env.mjs mock",
    "dev:server": "pnpm --filter @nibi/server dev",
    "dev:official-mcp": "node scripts/dev-official-mcp-server.mjs",
    "prepare": "husky && pnpm build:cua",
    "prepare:desktop-runtime": "pnpm --filter @nibi/desktop prepare:runtime-assets",
    "dep:graph": "node scripts/dependency-graph.mjs",
    "dep:refs": "node scripts/dep-refs.mjs",
    "audit:agent-remnants": "node scripts/audit-nibi-agent-remnants.mjs",
    "audit:conversation-session-coverage": "node scripts/audit-conversation-session-case-coverage.mjs --check",
    "audit:conversation-session-complete": "node scripts/audit-conversation-session-case-coverage.mjs --check --require-complete",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "pnpm --filter @nibi/desktop test:e2e",
    "test:e2e:all:coverage": "pnpm --filter @nibi/desktop test:e2e:all:coverage",
    "test:e2e:windows:sharded": "pnpm --filter @nibi/desktop test:e2e:windows:sharded",
    "test:e2e:container": "bash scripts/test-desktop-e2e-container.sh",
    "test:e2e:container:conversation": "bash scripts/test-desktop-e2e-container.sh conversation-session-verified",
    "test:e2e:container:plugins": "bash scripts/test-desktop-e2e-container.sh plugins-verified",
    "test:coverage": "vitest run --coverage --exclude \"packages/desktop/test/e2e/**/*.test.ts\"",
    "test:unit": "vitest run --exclude \"packages/desktop/test/e2e/**/*.test.ts\"",
    "test:unit:affected": "node scripts/run-affected-unit-tests.mjs",
    "test:unit:changed": "node scripts/run-affected-unit-tests.mjs --scope worktree",
    "test:docker:web-app-gateway": "node scripts/test-web-app-gateway-reset.mjs",
    "verify:pre-push": "pnpm run lint && pnpm run check:a11y && pnpm run db:schema:check && pnpm run test:architecture && pnpm run test:release-tooling && pnpm run architecture:check -- --changed && pnpm run check:identity-residue && pnpm run check:storage-keys && pnpm run check:session-agent && pnpm run check:kernel-licenses && pnpm run check:visual-brand && pnpm run check:i18n-keys && pnpm run test:unit:affected --scope push",
    "check:a11y": "node scripts/check-ui-a11y.mjs",
    "check:a11y:update": "node scripts/check-ui-a11y.mjs --update-baseline",
    "check:visual-brand": "node scripts/check-visual-brand.mjs",
    "check:identity-residue": "node scripts/check-identity-residue.mjs",
    "build": "pnpm -r build",
    "build:desktop-agent:bytecode": "node scripts/build-desktop-agent-bytecode.mjs",
    "build:docs": "pnpm --filter @nibi/dev-docs build",
    "build:web-remote-control:test": "pnpm --filter @nibi/web exec vite build --base=/remote/__test__/",
    "build:web-share": "pnpm --filter @nibi/web-share build",
    "build:bootstrap": "pnpm -r --filter \"./packages/*\" --filter \"!@nibi/desktop\" build && pnpm --filter @nibi/desktop build:no-runtime-assets",
    "build:native-search": "node scripts/build-native-search-tools.mjs",
    "pack:native-search": "node scripts/package-native-search-tools.mjs",
    "ci:ensure-native-search-deps": "node scripts/ensure-native-search-deps.mjs",
    "test:native-search:e2e": "node scripts/test-native-search-tools-e2e.mjs",
    "clean": "node scripts/clean.mjs",
    "build:workspace-dists": "tsc -b packages/shared/tsconfig.testing.json packages/rpc packages/provider packages/provider-node packages/shared packages/services packages/client packages/server packages/nibi-server-cli packages/ui packages/web apps/dev-docs packages/e2e-report",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:serial": "node scripts/typecheck.mjs --concurrency 1",
    "bundle:desktop": "pnpm --filter @nibi/desktop run bundle --",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "count-lines": "bash scripts/count-lines.sh",
    "prepare:remote-assets": "pnpm --filter @nibi/server-cli stage:remote-assets",
    "prepare:remote-assets:linux": "pnpm --filter @nibi/server-cli stage:remote-assets --linux",
    "ci:assert-node": "node scripts/assert-node-version.mjs",
    "build:cua": "pnpm --filter @nibi/cua build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:with-remote": "node scripts/bootstrap.mjs --with-remote",
    "release": "release-it",
    "release:status": "node scripts/release/status.mjs",
    "release:verify": "node scripts/release/verify.mjs",
    "release:record": "node scripts/release/record.mjs",
    "test:release-tooling": "node --test scripts/test/release-tooling.test.mjs",
    "architecture:check": "node scripts/architecture/architecture-check.mjs check",
    "architecture:report": "node scripts/architecture/architecture-check.mjs report",
    "architecture:baseline:update": "node scripts/architecture/architecture-check.mjs baseline:update",
    "architecture:context": "node scripts/architecture/architecture-check.mjs context",
    "test:architecture": "node --test scripts/test/architecture-governance.test.mjs scripts/test/architecture-governance-review.test.mjs scripts/test/architecture-upstream-admission.test.mjs scripts/test/source-size-policy.test.mjs",
    "test:rust-npm-package": "node --test scripts/rust-cli/npm/package.test.mjs scripts/rust-cli/npm/meta-package.test.mjs",
    "test:sync-upstream-provider-config": "node --test scripts/sync-upstream-provider-config.test.mjs",
    "architecture:adopt": "node scripts/architecture/architecture-check.mjs adopt",
    "db:schema:check": "node --test scripts/test/sqlite-schema-contract.test.mjs && pnpm --dir apps/nibi-cli exec tsx ../../scripts/check-sqlite-schema.ts",
    "db:schema:update": "pnpm --dir apps/nibi-cli exec tsx ../../scripts/check-sqlite-schema.ts --update",
    "check:i18n-keys": "python scripts/check-i18n-keys.py",
    "check:public-repo": "node scripts/check-public-repo.mjs",
    "check:storage-keys": "node scripts/check-storage-keys.mjs",
    "check:session-agent": "node scripts/check-session-agent-identity.mjs",
    "check:kernel-licenses": "node scripts/check-kernel-licenses.mjs"
  },
  "dependencies": {
    "border-beam": "^1.0.1",
    "d3-path": "^3.1.0",
    "tailwind-scrollbar-hide": "^4.0.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@release-it/conventional-changelog": "^10.0.6",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.1",
    "@nibi/cua": "workspace:*",
    "concurrently": "^9.1.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "conventional-changelog-writer": "^8.4.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "6.0.3",
    "knip": "^6.0.6",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "release-it": "^19.2.4",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.4",
    "turbo": "^2.4.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1",
    "electron-to-chromium": "^1.5.478"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.13.23"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "node-abi": "4.40.0",
      "electron-to-chromium": "^1.5.478"
    },
    "patchedDependencies": {
      "@radix-ui/react-collapsible@1.1.12": "patches/@radix-ui__react-collapsible@1.1.12.patch",
      "vitest@4.1.7": "patches/vitest@4.1.7.patch",
      "wdio-electron-service@9.2.1": "patches/wdio-electron-service@9.2.1.patch",
      "@arms/rum-electron@0.0.3": "patches/@arms__rum-electron@0.0.3.patch",
      "@ai-sdk/openai-compatible@2.0.60": "patches/@ai-sdk__openai-compatible@2.0.60.patch",
      "@ai-sdk/anthropic@3.0.81": "patches/@ai-sdk__anthropic@3.0.81.patch"
    }
  },
  "license": "Apache-2.0"
}
