# syntax=docker/dockerfile:1.7

# Desktop Electron E2E demo image.
#
# Build and run with:
#   bash scripts/test-desktop-e2e-container.sh

FROM node:24.22.1-bookworm

ARG PNPM_VERSION=10.33.2

# 可选的二进制镜像源。默认空串 = 与上游一致（从官方源下载）；在本机/CI 上拉不动
# GitHub 的网络里，可以不改这个文件、只加构建参数：
#   docker build --build-arg ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ...
# 空串是安全的：electron 的 install.js 走 @electron/get，`ELECTRON_MIRROR` 为空时按 falsy 回退官方源。
ARG ELECTRON_MIRROR=""

# `NIBI_E2E_SPEC` 与 `scripts/test-desktop-e2e-container.sh` 的 DEFAULT_E2E_SPEC 保持一致：
# 这是**默认 smoke** 短名单，必须不含 `conversation-session/`（那一族只走 verified 预设逐条准入，
# 见脚本里的 CONVERSATION_SESSION_VERIFIED_E2E_SPEC）。**不要**放 `upstream-provider.test.ts`
# ——它要真实上游地址与 API key，容器 `--network none` 永远满足不了。
ENV CI=1 \
    HUSKY=0 \
    PNPM_HOME=/pnpm \
    PNPM_STORE_DIR=/pnpm/store \
    XDG_CACHE_HOME=/workspace/.cache \
    WDIO_BROWSER_DRIVER_CACHE_DIR=/workspace/.cache/wdio-browser-drivers \
    NIBI_E2E_CONTAINER=1 \
    NIBI_E2E_SPEC=./test/e2e/container-boot.test.ts,./test/e2e/smoke.test.ts,./test/e2e/e2ecase-regression.test.ts,./test/e2e/task-list-archive-confirmation.test.ts \
    ELECTRON_DISABLE_SECURITY_WARNINGS=1 \
    TURBO_TELEMETRY_DISABLED=1

ENV PATH="${PNPM_HOME}:${PATH}"
ENV ELECTRON_MIRROR=${ELECTRON_MIRROR}

# 使用 HTTPS 避免本机或 CI 的 HTTP 代理误拦带 URL 编码的 Debian 包路径。
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      curl \
      dbus \
      dbus-x11 \
      fonts-noto-cjk \
      fonts-noto-color-emoji \
      g++ \
      git \
      libasound2 \
      libatk-bridge2.0-0 \
      libatk1.0-0 \
      libatspi2.0-0 \
      libcairo2 \
      libcups2 \
      libdbus-1-3 \
      libdrm2 \
      libgbm1 \
      libglib2.0-0 \
      libgtk-3-0 \
      libnspr4 \
      libnss3 \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      libsecret-1-0 \
      libx11-6 \
      libx11-xcb1 \
      libxcb-dri3-0 \
      libxcomposite1 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxkbcommon0 \
      libxkbfile1 \
      libxrandr2 \
      libxrender1 \
      libxshmfence1 \
      libxss1 \
      libxtst6 \
      make \
      openssh-client \
      pkg-config \
      procps \
      python3 \
      unzip \
      wget \
      xdg-utils \
      xvfb \
      xz-utils && \
    rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare "pnpm@${PNPM_VERSION}" --activate

WORKDIR /workspace

COPY . .

RUN --mount=type=cache,id=zcode-desktop-e2e-pnpm-store,target=/pnpm/store \
    pnpm config set store-dir "${PNPM_STORE_DIR}" && \
    pnpm install --frozen-lockfile

# Electron 二进制必须烘进镜像：测试期是 replay-isolated（`--network none`），
# 跑的时候再下载必然失败（`install.js` fetch failed）。
#
# 不能指望 `pnpm install` 一定装好：构建缓存复用 pnpm store 时，依赖的 postinstall
# 不一定会重跑，`node_modules/electron/dist` 就可能是空的。这一层缺了一直没被发现，
# 因为这套 e2e 从没在干净环境里跑过（CI 运行次数是 0）。
#
# 构建期（有网络）补齐，并断言产物真的在——缺了就让构建失败，别留到运行阶段才炸。
RUN if [ ! -x node_modules/electron/dist/electron ]; then \
      echo "[desktop-e2e] electron binary missing after install; fetching at build time"; \
      node node_modules/electron/install.js; \
    fi && \
    test -x node_modules/electron/dist/electron && \
    echo "[desktop-e2e] electron binary ready: $(node -p 'require("./node_modules/electron/package.json").version')"

# 桌面宿主的 tsup 包里引用了 `@nibi/bootstrap/plugin-management`，而 bootstrap 的
# `exports` 指向 `dist/plugin-management.js`——**构建产物**，不是源码。也就是说
# `build:no-runtime-assets` 隐藏依赖 bootstrap 先被编译过；本地能过只是因为 dist 早就存在，
# 干净环境（本镜像、CI）就会 `Could not resolve "@nibi/bootstrap/plugin-management"`。
#
# 这里按依赖顺序把 desktop 之前的所有 workspace 包编出来（`^...` = 只编依赖，不编自己），
# 免得以后再有别的兄弟包以同样方式偷偷依赖构建产物。
RUN pnpm exec turbo run build --filter="@nibi/desktop^..."

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends xauth && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p "${WDIO_BROWSER_DRIVER_CACHE_DIR}"

CMD ["bash", "-lc", "dbus-run-session -- pnpm --filter @nibi/desktop test:e2e ${EXTRA_WDIO_ARGS:-}"]
