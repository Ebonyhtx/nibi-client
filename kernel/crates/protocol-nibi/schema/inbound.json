{
  "methods": {
    "provider/refreshRegistry": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "provider/updateAccountConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "basedOnNibiBuiltinRevision": {
          "type": "string",
          "minLength": 1
        },
        "providers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "states": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "availability": {
                "type": "string",
                "enum": [
                  "available",
                  "pending",
                  "unavailable",
                  "unknown"
                ]
              },
              "entitled": {
                "type": "boolean"
              },
              "unavailableReason": {
                "type": "string",
                "enum": [
                  "not-authenticated",
                  "not-connected",
                  "credential-failed",
                  "not-entitled"
                ]
              },
              "current": {
                "type": "boolean"
              },
              "connectionKey": {
                "type": "string"
              },
              "effectiveAt": {
                "type": "number"
              }
            },
            "required": [
              "availability",
              "entitled"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "revision",
        "basedOnNibiBuiltinRevision",
        "providers",
        "states"
      ],
      "additionalProperties": false
    },
    "runtime/capabilities": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "hostCapabilities": {
          "type": "object",
          "properties": {
            "sessionDirectorySource": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "session/close": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "expectedPersistence": {
          "type": "string",
          "enum": [
            "immediate",
            "deferred"
          ]
        }
      },
      "required": [
        "sessionId"
      ],
      "additionalProperties": false
    },
    "session/list": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "workspace": {
          "type": "object",
          "properties": {
            "workspacePath": {
              "type": "string",
              "minLength": 1
            },
            "workspaceIdentity": {
              "type": "string",
              "minLength": 1
            },
            "remoteSessionId": {
              "type": "string",
              "minLength": 1
            },
            "workspaceKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "workspacePath",
            "workspaceKey"
          ],
          "additionalProperties": false
        },
        "sessionIds": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "session/read": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "deliveryKind": {
          "type": "string",
          "enum": [
            "desktop-continuous",
            "web-remote-replayable"
          ]
        },
        "messageLimit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "afterSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contentProfile": {
          "type": "string",
          "enum": [
            "full",
            "index"
          ]
        }
      },
      "required": [
        "sessionId"
      ],
      "additionalProperties": false
    },
    "v4/command": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "inputOrigin": {
          "type": "string",
          "enum": [
            "desktop",
            "mobile"
          ]
        },
        "ttft": {
          "type": "object",
          "properties": {
            "version": {
              "type": "number",
              "const": 1
            },
            "observationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "localOnly": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "version",
            "observationId"
          ],
          "additionalProperties": false
        },
        "commandId": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseRevision": {
          "type": "number"
        },
        "baseLogEpoch": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "createSession",
            "createSelectionSideSession",
            "sendText",
            "sendGoalCommand",
            "stop",
            "compact",
            "forkAssistant",
            "applyFileRewind",
            "editUserQuery",
            "retryTurn",
            "setAssistantFeedback",
            "setHighspeedMetrics",
            "sendQueuedNow",
            "editQueueItem",
            "reorderQueueItem",
            "deleteQueueItem",
            "setAutoDrain",
            "resolveInteraction",
            "respondWorkspaceHookReview",
            "toggleWorkspaceHookReviewItem",
            "revokeWorkspaceHookTrust",
            "requestWorkspaceHookReview",
            "snoozeInteractionAutoResolution",
            "switchModelConfig",
            "switchCollaborationMode",
            "setFollowupMode",
            "pauseGoal",
            "resumeGoal",
            "cancelBackgroundWork",
            "resumeWorkflowRun",
            "startSavedWorkflow",
            "amendWorkflowRunSettings",
            "renameSession",
            "deleteSession",
            "discardSharedContext"
          ]
        },
        "payload": {},
        "issuedAt": {
          "type": "number"
        }
      },
      "required": [
        "commandId",
        "clientId",
        "sessionId",
        "type",
        "payload",
        "issuedAt"
      ]
    },
    "v4/commands/query": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "commands": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "commandId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sessionId",
              "commandId"
            ],
            "additionalProperties": false
          }
        },
        "clock": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "commands"
      ],
      "additionalProperties": false
    },
    "v4/connection/flow": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "connectionId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "saturated",
            "drained",
            "closed"
          ]
        }
      },
      "required": [
        "connectionId",
        "state"
      ],
      "additionalProperties": false
    },
    "v4/conversation/resync": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "subscriptionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "base": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "logEpoch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "seq": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "logEpoch",
                "seq"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "forceSnapshot": {
          "type": "boolean"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "connectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "subscriptionId",
        "base",
        "topic",
        "connectionId"
      ],
      "additionalProperties": false
    },
    "v4/conversation/subscribe": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "topic": {
          "type": "string"
        },
        "base": {
          "type": "object",
          "properties": {
            "logEpoch": {
              "type": "string"
            },
            "seq": {
              "type": "number"
            }
          },
          "required": [
            "logEpoch",
            "seq"
          ]
        },
        "retryInitialization": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "type": "string",
          "enum": [
            "foreground",
            "background"
          ]
        },
        "additionalDirectories": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "connectionId": {
          "type": "string"
        },
        "clientMode": {
          "type": "string",
          "enum": [
            "desktop-continuous",
            "web-remote-replayable"
          ]
        },
        "workspace": {
          "type": "object",
          "properties": {
            "workspacePath": {
              "type": "string",
              "minLength": 1
            },
            "workspaceIdentity": {
              "type": "string",
              "minLength": 1
            },
            "remoteSessionId": {
              "type": "string",
              "minLength": 1
            },
            "workspaceKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "workspacePath",
            "workspaceKey"
          ],
          "additionalProperties": false
        },
        "legacyTaskIds": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resumeThoughtLevel": {
          "type": "string",
          "minLength": 1
        },
        "workflowRunDeltas": {
          "type": "boolean"
        },
        "historyFirst": {
          "type": "boolean"
        }
      },
      "required": [
        "topic",
        "connectionId",
        "clientMode"
      ],
      "additionalProperties": false
    },
    "v4/conversation/unsubscribe": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "subscriptionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "connectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "topic",
        "subscriptionId",
        "connectionId"
      ],
      "additionalProperties": false
    },
    "v4/sessionsIndex/reconcile": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "sessionIds": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "workspaceId",
        "sessionIds"
      ],
      "additionalProperties": false
    },
    "workspace/readPresentation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "workspace": {
          "type": "object",
          "properties": {
            "workspacePath": {
              "type": "string",
              "minLength": 1
            },
            "workspaceIdentity": {
              "type": "string",
              "minLength": 1
            },
            "remoteSessionId": {
              "type": "string",
              "minLength": 1
            },
            "workspaceKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "workspacePath",
            "workspaceKey"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "workspace"
      ],
      "additionalProperties": false
    },
    "workspace/updateDynamicWorkflowPolicy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "workspace": {
          "type": "object",
          "properties": {
            "workspacePath": {
              "type": "string",
              "minLength": 1
            },
            "workspaceIdentity": {
              "type": "string",
              "minLength": 1
            },
            "remoteSessionId": {
              "type": "string",
              "minLength": 1
            },
            "workspaceKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "workspacePath",
            "workspaceKey"
          ],
          "additionalProperties": false
        },
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "disabled",
            "onDemand",
            "alwaysOn"
          ]
        }
      },
      "required": [
        "workspace",
        "enabled"
      ],
      "additionalProperties": false
    },
    "workspace/updateInteractionPreferences": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "workspace": {
          "type": "object",
          "properties": {
            "workspacePath": {
              "type": "string",
              "minLength": 1
            },
            "workspaceIdentity": {
              "type": "string",
              "minLength": 1
            },
            "remoteSessionId": {
              "type": "string",
              "minLength": 1
            },
            "workspaceKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "workspacePath",
            "workspaceKey"
          ],
          "additionalProperties": false
        },
        "preferences": {
          "type": "object",
          "properties": {
            "askUserQuestionAutoResolutionEnabled": {
              "type": "boolean"
            }
          },
          "required": [
            "askUserQuestionAutoResolutionEnabled"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "workspace",
        "preferences"
      ],
      "additionalProperties": false
    },
    "workspace/updateModelIoPreferences": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "workspace": {
          "type": "object",
          "properties": {
            "workspacePath": {
              "type": "string",
              "minLength": 1
            },
            "workspaceIdentity": {
              "type": "string",
              "minLength": 1
            },
            "remoteSessionId": {
              "type": "string",
              "minLength": 1
            },
            "workspaceKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "workspacePath",
            "workspaceKey"
          ],
          "additionalProperties": false
        },
        "preferences": {
          "type": "object",
          "properties": {
            "fullRetentionEnabled": {
              "type": "boolean"
            }
          },
          "required": [
            "fullRetentionEnabled"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "workspace",
        "preferences"
      ],
      "additionalProperties": false
    }
  },
  "replies": {
    "interaction/requestProviderRuntimeHeaders": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "headersApplied": {
              "type": "boolean",
              "const": true
            },
            "requestAuth": {
              "type": "object",
              "properties": {
                "apiKey": {
                  "type": "string",
                  "minLength": 1
                },
                "apiKeyId": {
                  "type": "string",
                  "minLength": 1
                },
                "accountScope": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "headers": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            },
            "errorMessage": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "headersApplied",
            "requestAuth"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "headersApplied": {
              "type": "boolean",
              "const": false
            },
            "errorMessage": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "headersApplied"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
