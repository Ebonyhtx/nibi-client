  "scope": {
    "node": "apps/nibi-cli/packages/core/src/tool/handlers/index.ts 的 builtInTools（静态内建工具清单；运行时条件注册不改变这份清单）",
    "rust": "kernel/crates/tools 的 nibi-kernel-tools 内置工具注册表（file_tools / Bash / interaction_tools / web_tools / cron_tools_with / authoring_tools / worktree_tools / topic_tools 等工厂），加上 nibi-kernel-agents 注册的 TodoRead / TodoWrite；对拍测试把这两层一起枚举",
    "excluded": [
      {
        "name": "Agent",
        "side": "node",
        "reason": "Rust 侧由 nibi-kernel-agents 注册（Agent 工具带 Task 别名）；本门禁只并入 agents 的 TodoRead / TodoWrite，其余 agents 工具仍不在枚举范围。"
      },
      {
        "name": "SendMessage",
        "side": "node",
        "reason": "Rust 侧由 nibi-kernel-agents 的 messaging 工具注册；跨层组装，不在本门禁范围。"
      },
      {
