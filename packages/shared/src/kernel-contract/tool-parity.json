        "side": "node",
        "reason": "Rust 侧由 nibi-kernel-ext 注册；跨层组装，不在本门禁范围。"
      },
      {
        "name": "Task",
        "side": "node",
        "reason": "Node 的子代理派发工具；Rust 的 Agent 工具以别名 Task 提供，由 nibi-kernel-agents 注册，不在本门禁范围。"
      },
      {
        "name": "TaskStop",
        "side": "node",
        "reason": "Rust 侧由 nibi-kernel-agents 注册；跨层组装，不在本门禁范围。"
      },
      {
        "name": "escalate",
        "side": "node",
        "reason": "Rust 侧由 nibi-kernel-agents 的 workflow actor 注册（端口在场时）；不在 tools crate。"
      },
