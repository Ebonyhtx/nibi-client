{
  "name": "@nibi/office-runtime",
  "version": "0.2.0",
  "private": true,
  "description": "Shared document viewer behind the built-in documents, spreadsheets, presentations and pdf plugins; each plugin chooses its formats in package.json under \"office\".",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#office/*": "./src/*",
    "#ui/*": "./ui/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint src ui scripts module.ts index.ts contract.ts contract.example.ts contract.test.ts --no-ignore"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "1.4.0",
    "@extend-ai/react-xlsx": "0.18.1",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "docx-preview": "0.4.1",
    "esbuild": "^0.28.2",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "jszip": "3.10.2",
    "pdfjs-dist": "5.4.296",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
