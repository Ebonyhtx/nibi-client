{
  "name": "@nibi/tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "test": "node --disable-warning=DEP0205 --import tsx --test tests/*.test.ts",
    "coverage": "c8 --reporter=text --reporter=html tsx --disable-warning=DEP0205 --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@mbears/opentui-core": "0.2.15",
    "@mbears/opentui-react": "0.2.15",
    "@nibi/contracts": "workspace:*",
    "@nibi/i18n": "workspace:*",
    "@nibi/shared": "workspace:*",
    "react": "19.3.1",
    "react-devtools-core": "7.0.1",
    "shiki": "^4.5.0",
    "web-tree-sitter": "0.27.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "tsx": "^4.23.15"
  }
}
