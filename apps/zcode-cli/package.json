{
  "name": "nibi-cli",
  "version": "0.17.0",
  "private": true,
  "description": "A cross-platform TypeScript Node.js CLI with a small TUI and optional SEA packaging.",
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=./packages/*",
    "build:sea": "pnpm --filter @nibi/cli build:sea",
    "check": "pnpm registry:check && turbo run typecheck --filter=./packages/* && pnpm test",
    "clean": "turbo run clean --filter=./packages/*",
    "cli:build": "pnpm --filter @nibi/cli build",
    "cli:dev": "pnpm --filter @nibi/cli dev",
    "cli:upload-sea": "pnpm --filter @nibi/cli upload:sea",
    "coverage": "turbo run coverage --filter=./packages/*",
    "dev": "pnpm --filter @nibi/cli dev",
    "format": "oxfmt --write package.json \"packages/**/*.json\" \"packages/**/*.ts\" \"packages/**/*.mjs\"",
    "format:check": "oxfmt --check package.json \"packages/**/*.json\" \"packages/**/*.ts\" \"packages/**/*.mjs\"",
    "lint": "node ../../scripts/run-cli-lint.mjs",
    "lint:count": "node scripts/count-ts-lines.mjs",
    "lint:fix": "turbo run lint:fix --filter=./packages/*",
    "prompt-trajectory:model-io": "pnpm --filter @nibi/prompt-trajectory model-io --",
    "prompt-trajectory:prompt": "pnpm --filter @nibi/prompt-trajectory record:prompt --",
    "prompt-trajectory:testcases": "pnpm --filter @nibi/prompt-trajectory run:testcases --",
    "registry:check": "node scripts/generate-bash-command-registry.mjs --check",
    "registry:generate": "node scripts/generate-bash-command-registry.mjs",
    "release": "node ../../node_modules/release-it/bin/release-it.js --config .release-it.json",
    "release:dry": "pnpm run release --release-version",
    "sea": "pnpm --filter @nibi/cli sea",
    "pretest": "pnpm --dir ../.. --filter @nibi/model-option-map build",
    "test": "turbo run test --filter=./packages/*",
    "test:e2e:memory": "pnpm --dir e2e/memory run e2e:build",
    "test:browser-headless": "pnpm --filter @nibi/browser-use-plugin... build && pnpm --filter @nibi/browser-use-plugin exec vitest run test/headless-browser.e2e.test.ts",
    "test:browser-headless:linux": "docker build --progress=plain -f packages/browser-use-plugin/e2e/headless-linux.Dockerfile ../..",
    "typecheck": "turbo run typecheck --filter=./packages/*"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "proxy-agent": "^8.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@withfig/autocomplete": "2.692.3",
    "c8": "^11.0.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "24.14.0"
  },
  "packageManager": "pnpm@10.33.2"
}
