# 正式环境链接常量；当前环境由构建脚本或 CI 注入 NIBI_ENV。
# client_id 是 OAuth 公开标识，不是 secret。
NIBI_PRODUCTION_BASE_URL=https://api.nibistudio.cn
# 远端 Source Server 发布包的下载源（构建期编译成 __NIBI_REMOTE_CDN_RELEASE_ROOTS__）。
# 必须与内容发布布局一致：OSS 桶 nibi-dist-hz 前缀 releases/，公网
# https://dl.nibistudio.cn/releases/electron/<version>/。缺这两行时生产包能构建、
# 能启动，但连接远端设备会在 probe 阶段报“远端资源下载源未配置”（4.1.0 即如此）。
CDN_DOMAIN=dl.nibistudio.cn
OSS_PATH_PREFIX=releases/electron
ZAI_PRODUCTION_OAUTH_ORIGIN=https://chat.z.ai
ZAI_PRODUCTION_BUSINESS_BASE_URL=https://api.z.ai
ZAI_PRODUCTION_OAUTH_CLIENT_ID=client_P8X5CMWmlaRO9gyO-KSqtg
